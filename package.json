{
  "name": "campus-match",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w @campus/db",
    "db:generate": "npm run db:generate -w @campus/db",
    "db:studio": "npm run studio -w @campus/db",
    "db:reset": "npm run reset -w @campus/db",
    "seed": "npm run seed -w @campus/core",
    "generate-seed": "npm run generate-seed -w @campus/core",
    "warmup": "npm run warmup -w @campus/core",
    "check-gemini": "npm run check-gemini -w @campus/core"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  }
}
